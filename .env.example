# Copy to .env.local for `next dev`, or to .env for Docker Compose.
# Fill in values yourself. Leave blank to run without that service.
# Never a live key in this file when it is committed. This example has no value.

# Platform Stripe secret. Used only to create direct charges on the studio's connected account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional override for tests that point the Stripe SDK at a local endpoint.
STRIPE_API_HOST=
STRIPE_API_PORT=
STRIPE_API_PROTOCOL=

# Set to 1 behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=

# Shared secret for POST /api/jobs/run. Leave blank to keep the route closed.
# Use a long random string in production.
JOB_SECRET=

# How often the Compose jobs sidecar calls /api/jobs/run, in seconds.
JOB_INTERVAL=300

# SQLite file. Defaults to data/openweek.db (uses data/studioflat.db if that file already exists).
# Compose sets this to /data/openweek.db on the named volume.
OPENWEEK_DB=

# Optional transactional email. Without it, reminders stay in the local outbox.
RESEND_API_KEY=
EMAIL_FROM=

# Published on /api/health. Compose and the image set this from the package version.
APP_VERSION=

# TLS overlay (`docker compose -f compose.yaml -f compose.prod.yaml up -d`).
# Buy the domain yourself. Do not put live keys here.
DOMAIN=
ACME_EMAIL=
