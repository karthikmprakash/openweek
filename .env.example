# Copy to .env.local and fill in values yourself. Leave blank to run without that service.

# Platform Stripe test secret. Used only to create direct charges on the studio's connected account.
# Never a live key in this file when it is committed. This example has no value.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional override for tests that point the Stripe SDK at a local endpoint.
STRIPE_API_HOST=
STRIPE_API_PORT=
STRIPE_API_PROTOCOL=

# Set to 1 behind HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=

# Shared secret for POST /api/jobs/run. Leave blank to keep the route closed.
JOB_SECRET=

# SQLite file. Defaults to data/studioflat.db
STUDIOFLAT_DB=

# Optional transactional email. Without it, reminders stay in the local outbox.
RESEND_API_KEY=
EMAIL_FROM=
